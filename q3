
#include <iostream>
#include <unordered_map>
using namespace std;

int main()
{
    int arr[] = {2, 3, 2, 4, 3, 2};
    int n = 6;

    unordered_map<int, int> freq;

    for(int i = 0; i < n; i++)
    {
        freq[arr[i]]++;
    }

    for(auto x : freq)
    {
        cout << x.first << " -> "
             << x.second << " times" << endl;
    }

    return 0;
}
